{
  "name": "i2s-business-os",
  "version": "1.0.0",
  "private": true,
  "description": "I2S Business OS - Enterprise Full-Stack Business Management Suite for Imagination2Software",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "npm run dev --workspace=server",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "install:all": "npm install"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.2.0"
  }
}
