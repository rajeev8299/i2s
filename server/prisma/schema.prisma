generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. AUTHENTICATION & USERS (8 ROLES)
// -------------------------------------------------------------
enum Role {
  SUPER_ADMIN
  ADMIN
  ACCOUNTS_MANAGER
  HR_MANAGER
  TEAM_LEADER
  STAFF
  INTERN
  CLIENT
}

enum EmploymentStatus {
  ACTIVE
  ON_PROBATION
  NOTICE_PERIOD
  RESIGNED
  TERMINATED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  SUBMITTED_FOR_REVIEW
  APPROVED
  CHANGES_REQUESTED
  COMPLETED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  passwordHash       String
  firstName          String
  lastName           String
  role               Role             @default(CLIENT)
  temporaryClientId  String?          @unique
  approvalStatus     ApprovalStatus   @default(APPROVED)
  approvalNotes      String?
  reviewedAt         DateTime?
  reviewedById       String?
  phone              String?
  avatarUrl          String?
  isActive           Boolean          @default(true)
  mustChangePassword Boolean          @default(false)
  resetToken         String?
  resetTokenExpiry   DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relationships
  employeeProfile  EmployeeProfile?
  clientProfile    ClientProfile?
  assignedTasks    Task[]           @relation("TaskAssignee")
  reviewedTasks    Task[]           @relation("TaskReviewer")
  taskComments     TaskComment[]
  leaveRequests    LeaveRequest[]
  attendances      Attendance[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  projectMemberships ProjectMember[]
  createdInvoices  Invoice[]        @relation("InvoiceCreator")
  recordedPayments Payment[]        @relation("PaymentRecorder")
  dailyReports     DailyWorkReport[] @relation("ReportAuthor")
  reviewedReports  DailyWorkReport[] @relation("ReportReviewer")
  reportReviews    WorkReportReview[] @relation("ReviewAuthor")
  requestedDailyReports DailyReportRequest[] @relation("ReportRequester")
  assignedDailyReports  DailyReportRequest[] @relation("ReportTarget")
  sentNotices           AdminNotice[]        @relation("NoticeSender")
  receivedNotices       NoticeRecipient[]    @relation("NoticeRecipientUser")
}

// -------------------------------------------------------------
// 2. HR & EMPLOYEE PROFILES
// -------------------------------------------------------------
model Department {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  employees   EmployeeProfile[]
}

model EmployeeProfile {
  id               String           @id @default(uuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode     String           @unique
  departmentId     String?
  department       Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation      String
  employmentStatus EmploymentStatus @default(ACTIVE)
  joiningDate      DateTime
  exitDate         DateTime?
  baseSalary       Decimal          @default(0.00) @db.Decimal(12, 2)
  stipendAmount    Decimal?         @db.Decimal(12, 2)
  bankName         String?
  accountNumber    String?
  ifscCode         String?
  panNumber        String?
  emergencyContact String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  payslips         Payslip[]
  leaveBalances    LeaveBalance[]
}

// -------------------------------------------------------------
// 3. CLIENT MANAGEMENT & CONTRACTS
// -------------------------------------------------------------
model ClientProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  gstin           String?
  address         String?
  city            String?
  country         String         @default("India")
  internalNotes   String?        // Strictly isolated from Client role view
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  contracts       Contract[]
  projects        Project[]
  invoices        Invoice[]
  serviceRequests ServiceRequest[]
}

model ServiceCatalog {
  id                String   @id @default(uuid())
  title             String   @unique
  category          String   @default("Development") // Website Development, SEO, Digital Marketing, Design, etc.
  description       String?
  deliverables      String?  // JSON array or newline list of included deliverables
  pricingModel      String   @default("FIXED") // FIXED, HOURLY, MONTHLY_RETAINER
  basePrice         Decimal  @db.Decimal(12, 2)
  billingFrequency  String   @default("ONE_TIME") // ONE_TIME, MONTHLY, QUARTERLY, ANNUAL
  estimatedDuration String?  // e.g. "2-4 Weeks", "Ongoing"
  unit              String   @default("project")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Contract {
  id              String         @id @default(uuid())
  clientId        String
  client          ClientProfile  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title           String
  contractNumber  String         @unique
  startDate       DateTime
  endDate         DateTime
  totalValue      Decimal        @db.Decimal(12, 2)
  status          String         @default("ACTIVE") // ACTIVE, EXPIRED, TERMINATED
  documentUrl     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// -------------------------------------------------------------
// 4. PROJECTS, TASKS & APPROVAL WORKFLOW
// -------------------------------------------------------------
model Project {
  id             String          @id @default(uuid())
  clientId       String
  client         ClientProfile   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name           String
  code           String          @unique
  description    String?
  priority       ProjectPriority @default(MEDIUM)
  status         ProjectStatus   @default(PLANNING)
  startDate      DateTime
  deadline       DateTime
  budget         Decimal?        @db.Decimal(12, 2)
  progress       Int             @default(0) // 0 to 100%
  isClientPortal Boolean         @default(true) // Visible to client
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  members        ProjectMember[]
  milestones     ProjectMilestone[]
  tasks          Task[]
  dailyReports   DailyWorkReport[]
  clientUpdates  ClientProgressUpdate[]
  dailyReportRequests DailyReportRequest[]
  serviceRequests     ServiceRequest[]
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleTitle String   @default("Member") // E.g., Team Leader, Lead Dev, Designer
  isLeader  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model ProjectMilestone {
  id              String    @id @default(uuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  dueDate         DateTime
  isCompleted     Boolean   @default(false)
  isClientVisible Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Task {
  id              String          @id @default(uuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  priority        ProjectPriority @default(MEDIUM)
  status          TaskStatus      @default(TODO)
  deadline        DateTime
  assigneeId      String?
  assignee        User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reviewerId      String?
  reviewer        User?           @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  submissionNotes String?
  reviewFeedback  String?
  isClientVisible Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  comments        TaskComment[]
  dailyReports    DailyWorkReport[]
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())
}

// -------------------------------------------------------------
// 5. FINANCE, DOUBLE-ENTRY ACCOUNTING & INVOICING
// -------------------------------------------------------------
model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  clientId       String
  client         ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User          @relation("InvoiceCreator", fields: [createdById], references: [id])
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  currency       String        @default("INR")
  subtotal       Decimal       @db.Decimal(12, 2)
  taxRate        Decimal       @default(18.00) @db.Decimal(5, 2) // 18% GST default
  taxAmount      Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0.00) @db.Decimal(12, 2)
  balanceDue     Decimal       @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items          InvoiceItem[]
  payments       Payment[]
  serviceRequests ServiceRequest[]
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
}

model Payment {
  id             String    @id @default(uuid())
  receiptNumber  String    @unique
  invoiceId      String
  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedById   String
  recordedBy     User      @relation("PaymentRecorder", fields: [recordedById], references: [id])
  amount         Decimal   @db.Decimal(12, 2)
  paymentMethod  String    @default("BANK_TRANSFER") // BANK_TRANSFER, UPI, CASH, CHEQUE
  transactionRef String?
  paymentDate    DateTime  @default(now())
  notes          String?
  createdAt      DateTime  @default(now())
}

model Expense {
  id          String   @id @default(uuid())
  title       String
  category    String   // Software, Hosting, Office, Travel, Hardware, Misc
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @default(now())
  isApproved  Boolean  @default(true)
  receiptUrl  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Chart of accounts for double-entry bookkeeping
model Account {
  id             String            @id @default(uuid())
  code           String            @unique // E.g. 1000 Cash, 1100 AR, 4000 Revenue
  name           String
  type           AccountType
  balance        Decimal           @default(0.00) @db.Decimal(14, 2)
  createdAt      DateTime          @default(now())
  journalLines   JournalEntryLine[]
}

model JournalEntry {
  id          String             @id @default(uuid())
  entryNumber String             @unique
  date        DateTime           @default(now())
  description String
  reference   String?            // E.g., Invoice #INV-1001 or Payment #RCP-1001
  createdAt   DateTime           @default(now())

  lines       JournalEntryLine[]
}

model JournalEntryLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0.00) @db.Decimal(12, 2)
  credit         Decimal      @default(0.00) @db.Decimal(12, 2)
}

// -------------------------------------------------------------
// 6. ATTENDANCE, LEAVE & PAYROLL
// -------------------------------------------------------------
model Attendance {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime  @db.Date
  checkInTime  DateTime?
  checkOutTime DateTime?
  status       String    @default("PRESENT") // PRESENT, HALF_DAY, ABSENT, WORK_FROM_HOME
  notes        String?
  createdAt    DateTime  @default(now())

  @@unique([userId, date])
}

model LeaveBalance {
  id                String          @id @default(uuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  leaveType         String          // CASUAL, SICK, PAID, UNPAID
  totalAllowed      Int             @default(12)
  usedDays          Int             @default(0)
  remainingDays     Int             @default(12)

  @@unique([employeeProfileId, leaveType])
}

model LeaveRequest {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType   String      // CASUAL, SICK, PAID, UNPAID
  startDate   DateTime
  endDate     DateTime
  daysCount   Int
  reason      String
  status      LeaveStatus @default(PENDING)
  adminNote   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Payslip {
  id                String          @id @default(uuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  month             Int             // 1 to 12
  year              Int
  basicSalary       Decimal         @db.Decimal(12, 2)
  allowances        Decimal         @default(0.00) @db.Decimal(12, 2)
  deductions        Decimal         @default(0.00) @db.Decimal(12, 2)
  netSalary         Decimal         @db.Decimal(12, 2)
  isPaid            Boolean         @default(false)
  paymentDate       DateTime?
  payslipPdfUrl     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([employeeProfileId, month, year])
}

// -------------------------------------------------------------
// 7. NOTIFICATIONS, AUDIT LOGS & SETTINGS
// -------------------------------------------------------------
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, TASK, FINANCE, LEAVE, SYSTEM, NOTICE
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// -------------------------------------------------------------
// 8. ADMIN OFFICIAL NOTICES & BROADCASTS (7 ROLES ONLY)
// -------------------------------------------------------------
model AdminNotice {
  id           String            @id @default(uuid())
  senderId     String
  sender       User              @relation("NoticeSender", fields: [senderId], references: [id], onDelete: Cascade)
  title        String
  content      String
  noticeType   String            @default("GENERAL") // GENERAL, OFFICIAL_NOTICE, ANNOUNCEMENT, URGENT
  priority     String            @default("NORMAL") // NORMAL, IMPORTANT, URGENT
  targetType   String            @default("ALL_EMPLOYEES") // ALL_EMPLOYEES, SPECIFIC_ROLES, SPECIFIC_USERS
  targetRoles  String?           // Comma-separated roles (only non-client roles allowed)
  status       String            @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  publishedAt  DateTime          @default(now())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  recipients   NoticeRecipient[]
}

model NoticeRecipient {
  id        String       @id @default(uuid())
  noticeId  String
  notice    AdminNotice  @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation("NoticeRecipientUser", fields: [userId], references: [id], onDelete: Cascade)
  isRead    Boolean      @default(false)
  readAt    DateTime?
  createdAt DateTime     @default(now())

  @@unique([noticeId, userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // E.g., USER_LOGIN, INVOICE_CREATED, STATUS_TRANSITION
  entity     String   // E.g., Invoice, Task, User, Payment
  entityId   String?
  details    String?  // JSON formatted or text summary
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model CompanySetting {
  id           String   @id @default(uuid())
  key          String   @unique
  value        String
  category     String   @default("GENERAL")
  description  String?
  updatedAt    DateTime @updatedAt
}

model RolePermission {
  id        String   @id @default(uuid())
  role      Role
  module    String   // dashboard, users, clients, projects, tasks, finance, hr, payroll, reports, settings
  action    String   // view, create, edit, delete, approve, export
  isAllowed Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, module, action])
}

// -------------------------------------------------------------
// 8. DAILY WORK TRACKING & CLIENT PROGRESS PORTAL
// -------------------------------------------------------------
enum ReportStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  RETURNED_FOR_CORRECTION
}

model DailyWorkReport {
  id                  String            @id @default(uuid())
  authorId            String
  author              User              @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  projectId           String
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId              String?
  task                Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reportDate          DateTime          @db.Date
  workTitle           String
  description         String
  completedWork       String?           // Explicit record of what was completed today
  pendingWork         String?           // Explicit record of what remains pending
  currentStatus       String?           // Current status summary
  status              ReportStatus      @default(SUBMITTED)
  timeSpentMinutes    Int               @default(0) // Time spent in minutes
  completionPercent   Int               @default(0) // 0 to 100%
  workLinks           String?           // URLs, GitHub PRs, Figma, Staging
  blockers            String?
  nextSteps           String?
  plannedTomorrow     String?
  internalNotes       String?           // Strictly internal, invisible to client
  clientSummary       String?           // Client-facing progress description
  isClientPublished   Boolean           @default(false)
  isForwardedToAdmin  Boolean           @default(false) // Forwarded by Team Leader to Admin
  forwardedAt         DateTime?
  reviewedReportsCount Int?             // Team Leader's count of intern reports reviewed today
  reviewerId          String?
  reviewer            User?             @relation("ReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewFeedback      String?
  reviewedAt          DateTime?
  submittedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  reviews             WorkReportReview[]
  clientProgressUpdates ClientProgressUpdate[]

  @@index([authorId, reportDate])
  @@index([projectId, reportDate])
}

model WorkReportReview {
  id             String          @id @default(uuid())
  reportId       String
  report         DailyWorkReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reviewerId     String
  reviewer       User            @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Cascade)
  decision       ReportStatus    // APPROVED or RETURNED_FOR_CORRECTION
  feedback       String
  previousStatus ReportStatus
  createdAt      DateTime        @default(now())
}

model ClientProgressUpdate {
  id                String           @id @default(uuid())
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportId          String?
  report            DailyWorkReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  updateDate        DateTime         @db.Date
  title             String
  completedToday    String
  currentStatus     String           @default("In Progress")
  nextSteps         String?
  deliverableLinks  String?
  publishedById     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([projectId, updateDate])
}

// -------------------------------------------------------------
// 9. TEAM LEADER DAILY REPORT REQUEST WORKFLOW
// -------------------------------------------------------------
enum ReportRequestStatus {
  PENDING
  SUBMITTED
  COMPLETED
  OVERDUE
}

model DailyReportRequest {
  id           String              @id @default(uuid())
  requesterId  String
  requester    User                @relation("ReportRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  targetUserId String
  targetUser   User                @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportDate   DateTime            @db.Date
  deadline     DateTime?
  instructions String?
  status       ReportRequestStatus @default(PENDING)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([targetUserId, reportDate])
  @@index([requesterId, projectId])
}

// -------------------------------------------------------------
// 10. CLIENT SERVICE SELECTION, QUOTATION & PAYMENT WORKFLOW
// -------------------------------------------------------------
enum ServiceRequestStatus {
  SUBMITTED
  QUOTATION_PENDING
  AWAITING_CLIENT_APPROVAL
  AWAITING_PAYMENT
  PAYMENT_PENDING
  PAID
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ServiceRequest {
  id               String               @id @default(uuid())
  requestNumber    String               @unique
  clientId         String
  client           ClientProfile        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceIds       String               // JSON array of ServiceCatalog IDs
  serviceTitles    String               // Readable summary of selected services
  requirements     String               // Client-specified project scope & requirements
  targetDate       DateTime?
  referenceLinks   String?              // URLs, assets, branding guidelines
  estimatedBudget  Decimal?             @db.Decimal(12, 2)
  quotationAmount  Decimal?             @db.Decimal(12, 2)
  quotationNotes   String?
  status           ServiceRequestStatus @default(SUBMITTED)
  
  invoiceId        String?
  invoice          Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  projectId        String?
  project          Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  assignedLeaderId String?              // Assigned Team Leader for auto-provisioned project
  
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([clientId, status])
}

