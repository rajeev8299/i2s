# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL 18 default or your configured credentials)
# Replace 'postgres:password' with your local PostgreSQL credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/i2s_business_os?schema=public"

# Authentication Secrets
JWT_SECRET=i2s_enterprise_jwt_super_secret_key_change_in_production_2026
JWT_EXPIRES_IN=24h
COOKIE_SECRET=i2s_enterprise_cookie_secret_safe_key_2026

# Company Details
COMPANY_NAME="Imagination2Software"
COMPANY_EMAIL="contact@imagination2software.com"
DEFAULT_CURRENCY="INR"

# External Integrations (Leave empty if not yet configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
