# ==============================================================================
# Imagination2Software (I2S) Business Management Platform
# Server Environment Configuration
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database Configuration (MySQL 8.0+ / 5.7+ or PostgreSQL)
# ------------------------------------------------------------------------------
# For MySQL:
DATABASE_URL="mysql://username:password@localhost:3306/i2s_business_os"

# For PostgreSQL (Alternative):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/i2s_business_os?schema=public"

# Database Individual Parameters (for direct connection pooling / scripts)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=i2s_business_os
DB_USER=i2s_user
DB_PASSWORD=your_secure_password_here

# ------------------------------------------------------------------------------
# Authentication & Security Secrets
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_signing_secret_min_32_chars_long
JWT_EXPIRES_IN=24h
COOKIE_SECRET=your_cookie_signing_secret_min_32_chars_long
SESSION_SECRET=your_session_secret_min_32_chars_long

# ------------------------------------------------------------------------------
# Corporate Identity & Regional Defaults
# ------------------------------------------------------------------------------
COMPANY_NAME="Imagination2Software"
COMPANY_EMAIL="contact@imagination2software.com"
DEFAULT_CURRENCY="INR"
TIMEZONE="Asia/Kolkata"

# ------------------------------------------------------------------------------
# External Integrations (Optional)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
